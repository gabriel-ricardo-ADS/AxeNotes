# Copie para .env.local e preencha. Nunca versione o .env.local.
# Supabase → Project Settings → API (use a chave anon/publishable, NUNCA a service_role)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Web Push (fase 8) — chave pública VAPID (a privada fica só nos secrets do Supabase)
VITE_VAPID_PUBLIC_KEY=

# Usuário de teste para e2e/screenshots (crie no Supabase; dados fictícios)
E2E_EMAIL=
E2E_PASSWORD=
E2E_EMAIL_2=
E2E_PASSWORD_2=
